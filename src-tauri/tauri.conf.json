{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Dialogsys",
  "version": "0.0.1",
  "identifier": "com.dialogsys.editor",
  "build": {
    "frontendDist": "../dist/client",
    "devUrl": "http://127.0.0.1:4321",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "node scripts/prepare-tauri.mjs"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Dialogsys",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "resources/**/*": "resources/"
    },
    "externalBin": ["binaries/dialogsys-node"],
    "android": {
      "minSdkVersion": 24
    },
    "iOS": {
      "minimumSystemVersion": "14.0"
    }
  }
}
