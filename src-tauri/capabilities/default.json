{
	"$schema": "../gen/schemas/desktop-schema.json",
	"identifier": "default",
	"description": "Default Dialogsys capabilities",
	"windows": ["main"],
	"permissions": [
		"core:default",
		"shell:default",
		{
			"identifier": "shell:allow-execute",
			"allow": [
				{
					"name": "dialogsys-node",
					"sidecar": true,
					"args": true
				}
			]
		}
	]
}
