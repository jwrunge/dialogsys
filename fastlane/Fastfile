# Fastlane lanes for Dialogsys mobile (Tauri iOS / Android).
# Desktop releases use .github/workflows/release.yml instead.
#
# Prerequisites:
#   bundle install
#   npm ci
#   iOS: Xcode, CocoaPods, Apple signing certs / API key
#   Android: Android SDK/NDK, keystore or Play App Signing
#
# Usage:
#   bundle exec fastlane ios build
#   bundle exec fastlane android build
#   bundle exec fastlane ios beta      # after configuring upload_to_testflight
#   bundle exec fastlane android internal  # after configuring upload_to_play_store

require 'fileutils'

ROOT = File.expand_path('..', __dir__)

def run_from_root!(command)
  sh("cd #{ROOT} && #{command}")
end

default_platform(:ios)

platform :ios do
  desc 'Sync version from package.json and build iOS app via Tauri'
  lane :build do
    run_from_root!('npm run version:sync')
    run_from_root!('npm run tauri:ios:build')
    UI.success('iOS build finished. Artifacts are under src-tauri/gen/apple/build/')
  end

  desc 'Build and upload to TestFlight (configure signing + API key first)'
  lane :beta do
    build
    # upload_to_testflight(
    #   api_key_path: ENV['APP_STORE_CONNECT_API_KEY_PATH'],
    #   skip_waiting_for_build_processing: true
    # )
    UI.important('TestFlight upload is commented out — add credentials and uncomment upload_to_testflight.')
  end
end

platform :android do
  desc 'Sync version from package.json and build Android app via Tauri'
  lane :build do
    run_from_root!('npm run version:sync')
    run_from_root!('npm run tauri:android:build')
    UI.success('Android build finished. Artifacts are under src-tauri/gen/android/app/build/outputs/')
  end

  desc 'Build and upload to Play Store internal track (configure signing first)'
  lane :internal do
    build
    # upload_to_play_store(
    #   track: 'internal',
    #   json_key: ENV['PLAY_STORE_JSON_KEY'],
    #   aab: Dir[File.join(ROOT, 'src-tauri/gen/android/app/build/outputs/bundle/release/*.aab')].first
    # )
    UI.important('Play upload is commented out — add service account JSON and uncomment upload_to_play_store.')
  end
end
