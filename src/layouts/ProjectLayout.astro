---
import ProjectNav from '../components/ProjectNav.astro';
import OriginSwitcher from '../islands/OriginSwitcher.svelte';
import ProjectTitle from '../islands/ProjectTitle.svelte';
import type { ProjectMeta } from '../lib/schema/project';
import { getProject } from '../lib/server/projects';
import BaseLayout from './BaseLayout.astro';

interface Props {
	slug: string;
	current?: string;
	title?: string;
	variant?: 'default' | 'flow';
}

const { slug, current, title, variant = 'default' } = Astro.props;

let project: ProjectMeta;
try {
	project = await getProject(slug);
} catch {
	return Astro.redirect('/404');
}

const pageTitle = title ? `${title} · ${project.displayName}` : project.displayName;
---

<BaseLayout title={`${pageTitle} · Dialogsys`}>
	<div class:list={['project-shell', { 'project-shell--flow': variant === 'flow' }]}>
		<div class="container">
			<div class="project-header">
				<a href="/" class="back-link" data-transmut="include">← All projects</a>
				<ProjectTitle
					client:load
					slug={slug}
					displayName={project.displayName}
					description={project.description}
				/>
			</div>
			<ProjectNav slug={slug} current={current} />
			<OriginSwitcher client:load slug={slug} />
			{variant !== 'flow' && <slot />}
		</div>
		{variant === 'flow' && (
			<div class="flow-viewport">
				<slot />
			</div>
		)}
	</div>
</BaseLayout>

<style>
	.project-header {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		margin-bottom: 0.75rem;
	}

	.back-link {
		flex-shrink: 0;
		font-size: 0.9rem;
		color: var(--text-muted);
		text-decoration: none;
	}

	.back-link:hover {
		color: var(--accent);
		text-decoration: none;
	}

	.project-shell .container {
		width: 100%;
		max-width: 1100px;
	}

	.project-shell--flow {
		display: flex;
		flex-direction: column;
		min-height: 100dvh;
	}

	.project-shell--flow .container {
		flex-shrink: 0;
		align-self: center;
	}

	.project-shell--flow .container :global(.project-nav) {
		margin-bottom: 0;
		padding-bottom: 0;
	}

	.flow-viewport {
		flex: 1;
		min-height: 0;
		display: flex;
		flex-direction: column;
		width: min(100rem, 100vw);
		margin-inline: max(0px, (100vw - min(100rem, 100vw)) / 2);
	}
</style>
