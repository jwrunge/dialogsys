---
import BaseLayout from './BaseLayout.astro';
import ProjectNav from '../components/ProjectNav.astro';
import VersioningHeartbeat from '../islands/VersioningHeartbeat.svelte';
import { getProject } from '../lib/server/projects';

interface Props {
	slug: string;
	current?: string;
	title?: string;
}

const { slug, current, title } = Astro.props;
const project = await getProject(slug);
const pageTitle = title ? `${title} · ${project.displayName}` : project.displayName;
---

<BaseLayout title={`${pageTitle} · Dialogsys`}>
	<div class="container">
		<div class="project-header">
			<div>
				<a href="/" class="back-link">← All projects</a>
				<h1>{project.displayName}</h1>
				<p class="slug">{project.slug}</p>
			</div>
		</div>
		<ProjectNav slug={slug} current={current} />
		<VersioningHeartbeat client:load slug={slug} />
		<slot />
	</div>
</BaseLayout>

<style>
	.project-header {
		display: flex;
		align-items: flex-start;
		justify-content: space-between;
		gap: 1rem;
		margin-bottom: 0.5rem;
	}

	.back-link {
		display: inline-block;
		margin-bottom: 0.35rem;
		font-size: 0.9rem;
		color: var(--text-muted);
		text-decoration: none;
	}

	.back-link:hover {
		color: var(--accent);
		text-decoration: none;
	}

	.slug {
		margin: 0;
		color: var(--text-muted);
		font-size: 0.85rem;
		font-family: var(--mono);
	}
</style>
