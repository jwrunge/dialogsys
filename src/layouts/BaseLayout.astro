---
import TranslationProvider from '../islands/TranslationProvider.svelte';
import { getHtmlLangAttribute } from '../lib/server/translations';

interface Props {
	title?: string;
}

const { title = 'Dialogsys' } = Astro.props;
const htmlLang = getHtmlLangAttribute();
---

<!doctype html>
<html lang={htmlLang}>
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<title>{title}</title>
	</head>
	<body>
		<TranslationProvider client:load initialLocale={htmlLang} />
		<main data-transmut="include">
			<slot />
		</main>
	</body>
</html>

<style is:global>
	@import '../styles/global.css';
</style>
