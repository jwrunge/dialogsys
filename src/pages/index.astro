---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import CreateProjectForm from '../islands/CreateProjectForm.svelte';
import { listProjects } from '../lib/server/projects';

const projects = await listProjects();
---

<BaseLayout title="Dialogsys">
	<div class="container">
		<header class="page-header">
			<div>
				<h1>Projects</h1>
				<p class="lead">Author branching scenes for Godot. Projects are stored as files on disk.</p>
			</div>
			<a class="btn" href="/settings">Settings</a>
		</header>

		<section>
			<h2>Your projects</h2>
			{projects.length === 0 ? (
				<>
					<p class="muted">No projects yet. Create one below or open the bundled demo.</p>
					<p><a href="/projects/demo/characters" class="btn">Open demo project</a></p>
				</>
			) : (
				<div class="card-grid">
					{projects.map((project) => (
						<ProjectCard project={project} />
					))}
				</div>
			)}
		</section>

		<section>
			<h2>Create project</h2>
			<CreateProjectForm client:load />
		</section>
	</div>
</BaseLayout>

<style>
	.page-header {
		display: flex;
		align-items: flex-start;
		justify-content: space-between;
		gap: 1rem;
		margin-bottom: 2rem;
	}

	.page-header h1 {
		margin-bottom: 0.35rem;
	}

	.lead {
		color: var(--text-muted);
		margin: 0;
	}

	section {
		margin-bottom: 2.5rem;
	}

	section h2 {
		font-size: 1.1rem;
		margin-bottom: 1rem;
	}

	.muted {
		color: var(--text-muted);
	}
</style>
