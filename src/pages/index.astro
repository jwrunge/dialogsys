---
import ProjectHome from '../islands/ProjectHome.svelte';
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Dialogsys">
	<div class="container" data-transmut="include">
		<header class="page-header">
			<div>
				<h1>Projects</h1>
				<p class="lead">Author branching scenes for Godot. Projects are stored as files on disk.</p>
			</div>
			<a class="btn" href="/settings" data-transmut-attrs="title" title="Settings">Settings</a>
		</header>

		<section>
			<h2>Your projects</h2>
			<ProjectHome client:load />
		</section>
	</div>
</BaseLayout>

<style>
	.page-header {
		display: flex;
		align-items: flex-start;
		justify-content: space-between;
		gap: 1rem;
		margin-bottom: 2rem;
	}

	.page-header h1 {
		margin-bottom: 0.35rem;
	}

	.lead {
		color: var(--text-muted);
		margin: 0;
	}

	section h2 {
		font-size: 1.1rem;
		margin-bottom: 1rem;
	}
</style>
