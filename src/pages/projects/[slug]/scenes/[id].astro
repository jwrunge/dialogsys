---
import DialogGraphEditor from '../../../../islands/DialogGraphEditor.svelte';
import ProjectLayout from '../../../../layouts/ProjectLayout.astro';
import { getDialog, getSceneUsageStats } from '../../../../lib/server/projects';

const { slug, id } = Astro.params;

let sceneTitle = id!;
let sceneDescription = '';
let nodeCount = 0;
let sequenceCount = 0;

try {
	const graph = await getDialog(slug!, id!);
	sceneTitle = graph.displayName || id!;
	sceneDescription = graph.description ?? '';
	const usage = await getSceneUsageStats(slug!);
	const stats = usage[id!];
	nodeCount = stats?.nodeCount ?? 0;
	sequenceCount = stats?.sequenceCount ?? 0;
} catch {
	return Astro.redirect('/404');
}
---

<ProjectLayout slug={slug!} current="scenes" title={sceneTitle} variant="flow">
	<DialogGraphEditor
		client:only="svelte"
		slug={slug!}
		dialogId={id!}
		displayName={sceneTitle}
		description={sceneDescription}
		nodeCount={nodeCount}
		sequenceCount={sequenceCount}
	/>
</ProjectLayout>
