---
import ProjectLayout from '../../../layouts/ProjectLayout.astro';
import { listDialogs, getDialog, getCharacters } from '../../../lib/server/projects';
import { validateProject } from '../../../lib/compile/validate';

const { slug } = Astro.params;
const dialogs = await listDialogs(slug!);
const characters = await getCharacters(slug!);
const graphs = await Promise.all(dialogs.map((d) => getDialog(slug!, d.id)));
const issues = validateProject(graphs, characters);
const errorCount = issues.filter((i) => i.level === 'error').length;
const warnCount = issues.filter((i) => i.level === 'warning').length;
---

<ProjectLayout slug={slug!} current="dashboard">
	<p class="stats">
		{characters.characters.length} characters · {dialogs.length} dialogs
		{errorCount > 0 && (
			<span class="badge badge-error">{errorCount} errors</span>
		)}
		{warnCount > 0 && (
			<span class="badge badge-warning">{warnCount} warnings</span>
		)}
	</p>

	<div class="card-grid">
		<a href={`/projects/${slug}/characters`} class="card card-link">
			<h3>Characters</h3>
			<p>Manage speakers, portraits, and voice notes.</p>
		</a>
		<a href={`/projects/${slug}/states`} class="card card-link">
			<h3>States</h3>
			<p>Global and per-character variables for branching.</p>
		</a>
		<a href={`/projects/${slug}/notes`} class="card card-link">
			<h3>Notes</h3>
			<p>Overview and scene direction notes.</p>
		</a>
		<a href={`/projects/${slug}/dialogs`} class="card card-link">
			<h3>Dialogs</h3>
			<p>Branching graph editors for each conversation.</p>
		</a>
		<a href={`/projects/${slug}/export`} class="card card-link">
			<h3>Export</h3>
			<p>Validate and export Godot JSON + DialogueRunner.</p>
		</a>
	</div>
</ProjectLayout>

<style>
	.stats {
		color: var(--text-muted);
		margin-bottom: 1.5rem;
		display: flex;
		gap: 0.5rem;
		align-items: center;
		flex-wrap: wrap;
	}

	.card-link {
		display: block;
		text-decoration: none;
		color: inherit;
	}

	.card-link:hover {
		text-decoration: none;
	}
</style>
