---
import ProjectLayout from '../../../../layouts/ProjectLayout.astro';
import SequenceListManager from '../../../../islands/SequenceListManager.svelte';

const { slug } = Astro.params;
---

<ProjectLayout slug={slug!} current="sequences" title="Sequences">
	<SequenceListManager client:only="svelte" slug={slug!}>
		<p slot="fallback" class="loading">Loading sequences…</p>
	</SequenceListManager>
</ProjectLayout>

<style>
	.loading {
		color: var(--text-muted);
		font-size: 0.9rem;
	}
</style>
