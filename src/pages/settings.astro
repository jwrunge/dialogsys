---
import SettingsEditor from '../islands/SettingsEditor.svelte';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getAppSettingsInfo } from '../lib/server/settings';

const info = getAppSettingsInfo();
---

<BaseLayout title="Settings · Dialogsys">
	<div class="container" data-transmut="include">
		<h1>Settings</h1>
		<p class="lead">
			Configure local project storage or connect to a self-hosted Dialogsys sync server.
			{info.storageMode === 'remote' && info.syncServerUrl ? (
				<>
					{' '}Currently using remote storage at{' '}
					<code data-transmut-skip>{info.syncServerUrl}</code>.
				</>
			) : (
				<>
					{' '}Local projects folder: <code data-transmut-skip>{info.resolvedPath}</code>.
				</>
			)}
		</p>
		<SettingsEditor client:load />
	</div>
</BaseLayout>

<style>
	.lead {
		color: var(--text-muted);
		margin-bottom: 1.5rem;
		max-width: 40rem;
	}

	.lead code {
		font-family: var(--mono);
		font-size: 0.85rem;
	}
</style>
